# Copy this file to .env and fill in local values. Never commit .env.

# Runtime: local or production.
ENVIRONMENT=local

# PostgreSQL. Required for migrations and any path that opens the database.
# Render supplies postgresql://...; the app rewrites that to postgresql+psycopg://.
# Local example:
# DATABASE_URL=postgresql+psycopg://moss:moss@localhost:5432/moss_garden
DATABASE_URL=

# This server's GitHub app. Register it once. Players never paste these.
# Locally, open /auth/github/setup and approve the app on your GitHub account.
# On Render, create a GitHub OAuth app by hand and set these in the dashboard.
# The setup page is turned off when ENVIRONMENT=production.
# After that, each player signs in with their own account at /auth/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Local runs build the callback from the browser's address. In production this
# falls back to RENDER_EXTERNAL_URL + /auth/github/callback when left empty.
GITHUB_OAUTH_CALLBACK_URL=

# Backboard is the only production LLM gateway. Keep this key on the server.
# Docs: https://docs.backboard.io/concepts/messages
# The model id stays empty until GET /models confirms a Gemma 4 pair.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=
BACKBOARD_MODEL_NAME=

# AI is off until the model id is confirmed. 0 means no model calls are budgeted.
# Commit messages are not sent unless AI_INCLUDE_COMMIT_MESSAGES is true.
AI_ENABLED=false
AI_DAILY_REQUEST_BUDGET=0
AI_INCLUDE_COMMIT_MESSAGES=false

# Audio is off by default. ElevenLabs is optional and separate from Backboard.
# Sound effects are generated once by backend/scripts/generate_sfx.py.
# AUDIO_ENABLED turns on weekly journal narration. Over the character cap, narration is skipped.
AUDIO_ENABLED=false
JOURNAL_NARRATION_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MONTHLY_CHAR_CAP=3000

# Sign-in cookie and GitHub token encryption. Required when ENVIRONMENT=production.
SESSION_SECRET=
TOKEN_FERNET_KEY=

# Bearer secret for POST /api/jobs/nightly. The GitHub Actions nightly sync sends it.
# Empty turns that endpoint off.
SYNC_SECRET=

# read:user is read-only and enough for public commits. public_repo and repo also grant write access.
GITHUB_SCOPES=read:user
DEMO_SEED=true
